#backend/.env.example — copy to .env and fill in real values. Never commit the real .env.
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
JWT_SECRET=
GOOGLE_VISION_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
EMAIL_USER=
EMAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# How many reverse-proxy hops sit in front of this server (Render/Railway/Fly/Vercel
# each count as 1). Express uses this to trust the right X-Forwarded-For entry when
# deriving a client's real IP for rate limiting — set it too low and a bad actor can
# spoof their IP via the header; too high (or missing, which defaults to 1 locally)
# and every user behind the proxy shares one rate-limit bucket. Usually 1 for a single
# reverse proxy in front of the app; 0 if there is none (e.g. running directly, no proxy).
TRUST_PROXY_HOPS=1
